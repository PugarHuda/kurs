DEPLOYER_PK=0x
# Reporter keys. Quorum defaults to a strict majority of however many are set.
REPORTER_1_PK=0x
REPORTER_2_PK=0x
REPORTER_3_PK=0x
REPORTER_4_PK=0x
REPORTER_5_PK=0x
