{
  "name": "@kurs/reporter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kurs reporter + transmitter: fetch prices, sign observations, relay rounds to Portaldot V3 and other EVM chains",
  "scripts": {
    "observe": "tsx src/cli.ts observe",
    "run": "tsx src/cli.ts run",
    "once": "tsx src/cli.ts once",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "evidence": "node evidence.mjs",
    "ink-e2e": "tsx scripts/ink-e2e.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "viem": "^2.57.14"
  },
  "devDependencies": {
    "@polkadot/api": "^17.0.2",
    "@polkadot/keyring": "^14.0.3",
    "@safe-global/protocol-kit": "^8.0.11",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
